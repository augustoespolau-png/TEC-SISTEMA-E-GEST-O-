NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ou_anon_key

# Nunca use esta chave no navegador. Necessária somente para /cadastros.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_ou_service_role_key

# URL permitida pelo Supabase Auth para convites e recuperação de senha.
NEXT_PUBLIC_SITE_URL=https://tec-sistema-e-gestao.vercel.app

# IA-TEC · Google Gemini (somente servidor)
GOOGLE_GENERATIVE_AI_API_KEY=sua_chave_google_ai_studio
# Opcional. Mantém um modelo estável por padrão no backend.
GEMINI_MODEL=gemini-2.5-flash
